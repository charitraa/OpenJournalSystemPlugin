msgid "plugins.themes.lrjstm.name"
msgstr "LRJSTM Theme"

msgid "plugins.themes.lrjstm.description"
msgstr "LBEF-branded academic journal theme for the LBEF Research Journal of Science, Technology and Management. A child theme of the OJS Default theme."

# Theme options

msgid "plugins.themes.lrjstm.option.tagline.label"
msgstr "Journal tagline"

msgid "plugins.themes.lrjstm.option.tagline.description"
msgstr "Short line shown under the journal name in the header."

msgid "plugins.themes.lrjstm.option.heroTitle.label"
msgstr "Homepage heading"

msgid "plugins.themes.lrjstm.option.heroTitle.description"
msgstr "Large heading above the homepage search box."

msgid "plugins.themes.lrjstm.option.heroSubtitle.label"
msgstr "Homepage search introduction"

msgid "plugins.themes.lrjstm.option.heroSubtitle.description"
msgstr "Short sentence under the homepage heading."

msgid "plugins.themes.lrjstm.option.callForPapers.label"
msgstr "Call for papers text"

msgid "plugins.themes.lrjstm.option.callForPapers.description"
msgstr "Shown in the Call for Papers box on the homepage. Leave empty to hide the box."

msgid "plugins.themes.lrjstm.option.subjectAreas.label"
msgstr "Subject areas"

msgid "plugins.themes.lrjstm.option.subjectAreas.description"
msgstr "One subject area per line. Each one links to an OJS search for that term. Leave empty to hide the section."

msgid "plugins.themes.lrjstm.option.aboutInstitution.label"
msgstr "About the publishing institution"

msgid "plugins.themes.lrjstm.option.aboutInstitution.description"
msgstr "Short paragraph about LBEF shown on the homepage and in the footer. Leave empty to hide it."

msgid "plugins.themes.lrjstm.option.institutionUrl.label"
msgstr "Institution website"

msgid "plugins.themes.lrjstm.option.institutionUrl.description"
msgstr "Full URL, for example https://www.lbef.org/"

msgid "plugins.themes.lrjstm.option.institutionPhone.label"
msgstr "Institution phone"

msgid "plugins.themes.lrjstm.option.institutionPhone.description"
msgstr "Shown in the footer. The journal contact name and email come from Settings > Journal > Contact."

msgid "plugins.themes.lrjstm.option.legacyArchiveUrl.label"
msgstr "Earlier volumes link"

msgid "plugins.themes.lrjstm.option.legacyArchiveUrl.description"
msgstr "Link to issues published before this OJS site (for example on lbef.org). Leave empty to hide the link."

msgid "plugins.themes.lrjstm.option.facebookUrl.label"
msgstr "Facebook URL"

msgid "plugins.themes.lrjstm.option.facebookUrl.description"
msgstr "Leave empty to hide."

msgid "plugins.themes.lrjstm.option.instagramUrl.label"
msgstr "Instagram URL"

msgid "plugins.themes.lrjstm.option.instagramUrl.description"
msgstr "Leave empty to hide."

msgid "plugins.themes.lrjstm.option.linkedinUrl.label"
msgstr "LinkedIn URL"

msgid "plugins.themes.lrjstm.option.linkedinUrl.description"
msgstr "Leave empty to hide."

msgid "plugins.themes.lrjstm.option.xUrl.label"
msgstr "X (Twitter) URL"

msgid "plugins.themes.lrjstm.option.xUrl.description"
msgstr "Leave empty to hide."

msgid "plugins.themes.lrjstm.option.youtubeUrl.label"
msgstr "YouTube URL"

msgid "plugins.themes.lrjstm.option.youtubeUrl.description"
msgstr "Leave empty to hide."

