# Theme options

msgid "plugins.themes.lrjstm.option.tagline.label"
msgstr "Journal tagline"

msgid "plugins.themes.lrjstm.option.tagline.description"
msgstr "Short line under the journal name in the header. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.heroTitle.label"
msgstr "Homepage headline"

msgid "plugins.themes.lrjstm.option.heroTitle.description"
msgstr "Large headline above the homepage search. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.callForPapers.label"
msgstr "Call for papers text"

msgid "plugins.themes.lrjstm.option.callForPapers.description"
msgstr "Shown in the Call for Papers banner on the homepage. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.subjectAreas.label"
msgstr "Research areas"

msgid "plugins.themes.lrjstm.option.subjectAreas.description"
msgstr "One area per line. Optionally add a short description after a vertical bar, e.g. \"Management | Business, finance and organisational research\". Each area links to an OJS search. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.publicationFrequency.label"
msgstr "Publication frequency"

msgid "plugins.themes.lrjstm.option.publicationFrequency.description"
msgstr "Shown in the homepage journal facts, e.g. \"Quarterly\". Leave empty if not officially defined."

msgid "plugins.themes.lrjstm.option.aboutInstitution.label"
msgstr "About the publishing institution"

msgid "plugins.themes.lrjstm.option.aboutInstitution.description"
msgstr "Short paragraph about LBEF shown in the homepage publishing section. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.institutionUrl.label"
msgstr "Institution website"

msgid "plugins.themes.lrjstm.option.institutionUrl.description"
msgstr "Full URL, for example https://www.lbef.org/. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.institutionPhone.label"
msgstr "Institution phone"

msgid "plugins.themes.lrjstm.option.institutionPhone.description"
msgstr "Shown in the footer. The journal contact name and email come from Settings > Journal > Contact. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.legacyArchiveUrl.label"
msgstr "Earlier volumes link"

msgid "plugins.themes.lrjstm.option.legacyArchiveUrl.description"
msgstr "Link to issues published before this OJS site, shown while no issue is published here. Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.policiesUrl.label"
msgstr "Policies page URL"

msgid "plugins.themes.lrjstm.option.policiesUrl.description"
msgstr "Link to a journal policies page (for example a Static Page). Leave empty to hide."

msgid "plugins.themes.lrjstm.option.ethicsUrl.label"
msgstr "Publication ethics page URL"

msgid "plugins.themes.lrjstm.option.ethicsUrl.description"
msgstr "Link to the publication ethics statement. Leave empty to hide."

msgid "plugins.themes.lrjstm.option.peerReviewUrl.label"
msgstr "Peer review page URL"

msgid "plugins.themes.lrjstm.option.peerReviewUrl.description"
msgstr "Link to the peer review process description. Leave empty to hide."

msgid "plugins.themes.lrjstm.option.accessibilityUrl.label"
msgstr "Accessibility statement URL"

msgid "plugins.themes.lrjstm.option.accessibilityUrl.description"
msgstr "Shown in the footer. Leave empty to hide."

msgid "plugins.themes.lrjstm.option.facebookUrl.label"
msgstr "Facebook URL"

msgid "plugins.themes.lrjstm.option.facebookUrl.description"
msgstr "Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.instagramUrl.label"
msgstr "Instagram URL"

msgid "plugins.themes.lrjstm.option.instagramUrl.description"
msgstr "Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.linkedinUrl.label"
msgstr "LinkedIn URL"

msgid "plugins.themes.lrjstm.option.linkedinUrl.description"
msgstr "Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.xUrl.label"
msgstr "X (Twitter) URL"

msgid "plugins.themes.lrjstm.option.xUrl.description"
msgstr "Enter a single hyphen (-) to hide."

msgid "plugins.themes.lrjstm.option.youtubeUrl.label"
msgstr "YouTube URL"

msgid "plugins.themes.lrjstm.option.youtubeUrl.description"
msgstr "Leave empty to hide."

